{% block turnstile_widget %}
    {% if enable %}
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" defer></script>
        {% set widget_id = 'turnstile_' ~ id %}
        {# api.js only renders .cf-turnstile: a class passed in attr is added to it, never substituted. #}
        {% set extra_classes = (attr.class|default(''))|split(' ')|filter(c => c is not empty and c != 'cf-turnstile') %}
        {% set attributes = attr|merge({class: (['cf-turnstile']|merge(extra_classes))|join(' ')}) %}

        <div id="{{ widget_id }}"
             data-sitekey="{{ key }}"
             {% if disable_submit_until_verified %}
             data-callback="{{ widget_id }}_onSuccess"
             data-error-callback="{{ widget_id }}_onError"
             data-expired-callback="{{ widget_id }}_onExpired"
             {% endif %}
             {% for attrKey, attribute in attributes %}{{ attrKey|e }}="{{ attribute }}" {% endfor %}>
        </div>

        {% if disable_submit_until_verified %}
        <script>
            (function () {
                var widgetId = '{{ widget_id }}';

                // Looked up at call time: the submit buttons are usually rendered after the widget.
                function submitButtons() {
                    var widget = document.getElementById(widgetId);
                    var form = widget ? widget.closest('form') : null;

                    return form
                        ? form.querySelectorAll('button[type="submit"], input[type="submit"], button:not([type])')
                        : [];
                }

                function setSubmitEnabled(enabled) {
                    submitButtons().forEach(function (btn) {
                        btn.disabled = !enabled;
                    });
                }

                // Defined synchronously, never from a DOMContentLoaded listener: Turnstile resolves the
                // data-*-callback names once, when it renders the widget. With api.js deferred, that render
                // is scheduled with setTimeout(0) and runs before DOMContentLoaded handlers in Firefox, so a
                // callback defined later would never be found and the buttons would stay disabled.
                window[widgetId + '_onSuccess'] = function () {
                    setSubmitEnabled(true);
                };

                window[widgetId + '_onError'] = function () {
                    setSubmitEnabled(false);
                };

                window[widgetId + '_onExpired'] = function () {
                    setSubmitEnabled(false);
                };
            })();
        </script>
        {% endif %}
    {% endif %}
{% endblock %}
